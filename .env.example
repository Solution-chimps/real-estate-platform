# Copy to .env (gitignored) and load it in your shell or IDE run configuration.
# Every value here is required for the default dev profile unless stated otherwise.

# At least 32 characters. Generate one: openssl rand -base64 48
APP_JWT_SECRET=

# AES-256 key (base64 of 32 random bytes) that encrypts TOTP secrets at rest. Generate: openssl rand -base64 32
APP_MFA_ENCRYPTION_KEY=

# Local TLS keystore created by scripts/generate-dev-cert (gitignored)
APP_SSL_KEYSTORE=./data/dev-keystore.p12
APP_SSL_KEYSTORE_PASSWORD=

# First admin user, created on startup only when no user exists yet
APP_ADMIN_EMAIL=
APP_ADMIN_NAME=
APP_ADMIN_PASSWORD=

# Optional: comma separated origins allowed to call the API with credentials.
# Leave empty when the Angular dev server proxies /api to this backend.
APP_CORS_ALLOWED_ORIGINS=

# Optional: where uploaded photos are written
APP_PHOTOS_DIR=./data/photos

# Only for the mysql profile
APP_DB_USERNAME=
APP_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
